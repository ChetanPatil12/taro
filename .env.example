# ── Taro server ──────────────────────────────────────────────
PORT=8000
DATABASE_PATH=./data/taro.db

# Base URL the frontend uses to reach the server
SERVER_URL=http://localhost:8000

# ── TrueForge (agent harness) ────────────────────────────────
# Local TrueForge instance: npx @truefoundry/trueforge
TRUEFORGE_URL=http://localhost:8790

# ── Model provider (configured inside TrueForge) ─────────────
OPENAI_API_KEY=sk-...

# ── Sandbox provider (configured inside TrueForge) ───────────
DAYTONA_API_KEY=dtn_...
